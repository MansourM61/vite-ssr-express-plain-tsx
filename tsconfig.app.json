{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./launcher",
        "outDir": "./dist",
        /* added types from @types */
        "lib": ["ESNext"],
        "types": ["bun", "vite/client", "unplugin-turbo-console/client"],
        /* Bundler mode */
        "moduleResolution": "bundler",
        /* transpilation settings */
        "module": "esnext",
        "target": "esnext",
        /* `noEmit` is required because we want to compile the TS file into JS. */
        "noEmit": false,
        /* Bundler mode */
        "moduleDetection": "force",
        /* Path aliases */
        "paths": {
            "@/*": ["./*"],
            "@app/*": ["./launcher/*"],
            "@app-lib/*": ["./launcher/lib/*"]
        }
    },
    "files": ["launcher/main.ts"],
    "include": ["launcher"]
}
