{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./launcher",
        "outDir": "./dist",
        /* added types from @types */
        "types": ["bun"],
        /* Bundler mode */
        "moduleResolution": "bundler",
        /* transpilation settings */
        "module": "esnext",
        "target": "esnext",
        /* `noEmit` is required because we want to compile the TS file into JS. */
        "noEmit": false
    },
    "files": ["launcher/main.ts"],
    "include": ["launcher"],
    "exclude": ["src", "vite.config.ts"]
}
