{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        /* Bundler mode */
        "moduleResolution": "bundler",
        "moduleDetection": "force"
        /* Path aliases */
    },
    "include": ["src"],
    "exclude": ["launcher", "vite.config.ts"]
}
