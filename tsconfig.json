{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        /* added types from @types */
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["bun", "vite/client", "unplugin-turbo-console/client"],
        /* Bundler mode */
        "moduleResolution": "bundler",
        /* transpilation settings */
        "module": "esnext",
        "target": "esnext",
        /* `noEmit` is required because we want to compile the TS file into JS. */
        "noEmit": true,
        /* Bundler mode */
        "moduleDetection": "force",
        /* Path aliases */
        "paths": {
            "@/*": ["./*"],
            "@app/*": ["./launcher/*"],
            "@src/*": ["./src/*"],
            "@app-lib/*": ["./launcher/lib/*"],
            "@src-lib/*": ["./src/lib/*"]
        }
    },
    "files": ["./vite.config.ts"],
    "include": ["launcher", "src"],
    "exclude": ["dist", "node_modules"]
}
