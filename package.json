{
    "name": "vite-ssr-express-plain-tsx",
    "description": "Server-side-rendering frontend vanilla TypeScript based on Vite with support of TSX and Express.js server",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun run --hot ./launcher/main.ts",
        "build": "bun run clean && bun run build:client-entry && bun run build:server-entry && bun run build:server-app",
        "build:client-entry": "vite build --outDir dist/client",
        "build:server-entry": "vite build --ssr src/entry-server.ts --outDir dist/server",
        "build:server-app": "tsc -p ./tsconfig.app.json",
        "preview": "cross-env NODE_ENV=production bun ./dist/main.js",
        "format": "bunx --bun @biomejs/biome format --write .",
        "lint": "bunx --bun @biomejs/biome check --write",
        "check-types": "tsc --noEmit",
        "clean": "rimraf ./dist",
        "prepare": "husky"
    },
    "dependencies": {
        "compression": "^1.8.1",
        "dotenv": "^17.4.0",
        "express": "^5.2.1",
        "sirv": "^3.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.10",
        "@tailwindcss/vite": "^4.2.2",
        "@types/bun": "^1.3.11",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^25.5.2",
        "@vitejs/devtools": "^0.1.13",
        "@vitest/ui": "^4.1.2",
        "cross-env": "^10.1.0",
        "husky": "^9.1.7",
        "jsx-dom": "^8.1.6",
        "lint-staged": "^16.4.0",
        "lodash-es": "^4.18.1",
        "rimraf": "^6.1.3",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.2",
        "unplugin-turbo-console": "^2.3.0",
        "vite": "^8.0.3",
        "vite-plugin-inspect": "^12.0.0-beta.1"
    },
    "lint-staged": {
        "**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
    },
    "repository": {
        "type": "git",
        "url": "git+"
    },
    "files": ["dist"],
    "packageManager": "bun@1.3.6"
}
