{
    "name": "vite-ssr-express-plain-tsx",
    "description": "Server-side-rendering frontend vanilla TypeScript based on Vite with support of TSX and Express.js server",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun server",
        "build": "bun run build:client && bun run build:server",
        "build:client": "vite build --outDir dist/client",
        "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
        "preview": "cross-env NODE_ENV=production bun server"
    },
    "dependencies": {
        "compression": "^1.8.1",
        "dotenv": "^17.4.0",
        "express": "^5.2.1",
        "sirv": "^3.0.2"
    },
    "devDependencies": {
        "@types/bun": "^1.3.11",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/node": "^25.5.0",
        "cross-env": "^10.1.0",
        "typescript": "^6.0.2",
        "vite": "^7.3.1"
    },
    "repository": {
        "type": "git",
        "url": "git+"
    },
    "files": [
        "dist"
    ],
    "packageManager": "bun@1.3.6"
}